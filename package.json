{
  "name": "ai-visual-lab",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3001",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3001",
    "lint": "eslint",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "typecheck": "next typegen && tsc --noEmit",
    "check": "pnpm test && pnpm typecheck && pnpm lint && pnpm build"
  },
  "dependencies": {
    "@huggingface/transformers": "3.8.1",
    "animejs": "4.5.0",
    "class-variance-authority": "^0.7.1",
    "lucide-react": "^1.47.0",
    "next": "16.4.5",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "cn": "^0.3.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "packageManager": "pnpm@10.33.2",
  "description": "Interactive visual experiments for learning computer vision and language models",
  "license": "MIT",
  "engines": {
    "node": ">=22.18.0 <25"
  },
  "pnpm": {
    "overrides": {
      "sharp": ">=0.35.5 <0.36",
      "source-map-js": ">=1.2.2 <2"
    }
  }
}
